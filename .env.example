# ===== MongoDB =====
MONGODB_URI=
MONGODB_DB=dodf_database
MONGODB_COLLECTION=documentos

# ===== Voyage AI (embeddings + rerank) =====
VOYAGE_API_KEY=
VOYAGE_API_PROVIDER=atlas
VOYAGE_EMBEDDING_MODEL=voyage-4-large
VOYAGE_EMBEDDING_DIMENSION=1024
VOYAGE_EMBEDDING_BATCH=128
VOYAGE_TRUNCATION=true
VOYAGE_RERANK_MODEL=rerank-2.5

# ===== Reranking =====
RERANK_ENABLED=true
RERANK_TOP_K=6
RERANK_TRUNCATION=true

# ===== LLMs =====
LLM_MODEL=gemma4:26b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
# Mistral OCR (opcional — so se OCR_PROVIDER=mistral; requer 'pip install mistralai')
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# ===== Processamento de PDF =====
PDF_FOLDER=
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
PDF_SERVER_PORT=8502

# ===== Ingestao paralela e resumivel (V2 #1) =====
# Numero de PDFs processados em paralelo (processos). Ajuste conforme CPU/rate-limit da API.
INGEST_WORKERS=4

# ===== Indice vetorial / quantizacao (V2 #2) =====
VECTOR_INDEX_NAME=busca_vetorial
VECTOR_FIELD=embedding
# none | scalar | binary  (scalar = ~3.75x menos memoria, recall quase intacto)
VECTOR_QUANTIZATION=scalar
# numCandidates do $vectorSearch (aumente com binary p/ compensar recall)
VECTOR_NUM_CANDIDATES=150
CACHE_INDEX_NAME=cache_vetorial
CACHE_VECTOR_FIELD=pergunta_embedding

# ===== Latencia / concorrencia (V2 #3) =====
# Pool do MongoClient (suporta milhares de interacoes/dia concorrentes)
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# Cache semantico (limiar de similaridade p/ hit; candidatos do vectorSearch)
CACHE_SIMILARITY=0.97
CACHE_NUM_CANDIDATES=10
# Rerank condicional: pula rerank quando melhor score semantico >= valor (0=desliga)
RERANK_SKIP_SCORE=0

# ===== Extracao estruturada de atos (Fase 1) =====
ATOS_COLLECTION=atos
ATOS_EXTRACTION_ENABLED=true
ATOS_LLM_ENABLED=true
# Threads paralelas no reforco de atos via LLM (V2 #4) — ajuste ao rate-limit do provedor
ATOS_REFORCO_WORKERS=4

# ===== OCR de fallback (so para paginas escaneadas/sem texto) =====
OCR_ENABLED=false
OCR_PROVIDER=gemini
OCR_MIN_CHARS=120
OCR_DPI=200
OCR_MAX_PAGES_POR_PDF=50
